    "p_heat_12": {"value": 2.5e-4, "description": "|1⟩ → |2⟩ heating probability", "code_location": "my_noise_model/paper_aligned.py:PaperAlignedNoiseConfig.p_heat_12"},
    "p_cz_leak_11_to_02": {"value": 2.0e-4, "description": "CZ-induced |11⟩ → |02⟩/|20⟩ leakage", "code_location": "my_noise_model/paper_aligned.py:PaperAlignedNoiseConfig.p_cz_leak_11_to_02"},
    "p_cz_crosstalk_ZZ": {"value": 5.5e-4, "description": "ZZ crosstalk error", "code_location": "my_noise_model/paper_aligned.py:PaperAlignedNoiseConfig.p_cz_crosstalk_ZZ"},
    "p_1q_excess": {"value": 6.2e-4, "description": "Single-qubit excess Pauli error", "code_location": "my_noise_model/paper_aligned.py:PaperAlignedNoiseConfig.p_1q_excess"},
    "p_cz_excess": {"value": 2.75e-3, "description": "CZ excess Pauli error", "code_location": "my_noise_model/paper_aligned.py:PaperAlignedNoiseConfig.p_cz_excess"}
